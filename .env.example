# GitHub App Configuration
# Get these values from your GitHub App settings page

# Your GitHub App ID (found in app settings)
APP_ID=

# Webhook secret (generate a random string)
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(20)'
WEBHOOK_SECRET=

# Private key from your GitHub App
# Option 1: Inline (recommended for cloud deployments)
# Format: Single line with \n for line breaks
# Convert .pem to inline format:
#   cat your-app.private-key.pem | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}'
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Option 2: Path to .pem file (recommended for local development)
# Uncomment and update path if using file-based key
# PRIVATE_KEY_PATH=./your-app.private-key.pem

# Optional: Sentry DSN for error tracking
# Get from https://sentry.io
# SENTRY_DSN=

# Optional: Node environment (defaults to development)
# NODE_ENV=production

# Optional: Log level (debug, info, warn, error)
# LOG_LEVEL=info
